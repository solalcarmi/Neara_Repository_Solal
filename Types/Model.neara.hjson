    {
      name: "veg~u_filter_district_formula"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula:
        '''
        if(
          or(u_filter_district_selected = "",u_filter_district_selected = null, u_filter_district_selected = "all"),
          
          list("MID","ODE"),
          list(u_filter_district_selected)
        )
        '''
    }
    {
      name: "veg~u_filter_district_select"
      prominence: "normal"
