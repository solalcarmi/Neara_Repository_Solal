    {
      name: "veg~u_points_veg"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula:
        '''
        broadcast(
          grid: make_grid(cell_size:500m,cover_point_cloud: true),
          
          categorize_volume(
            polygon_to_volume(grid,false,200m,200m),
            "model_veg",
            "veg" 
          )
        )
