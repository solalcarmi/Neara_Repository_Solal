      formula:
        '''
        let(
          points: u_veg_environment.u_p3_points,
          class: "P3",
        
          if(
            and(
              model().u_show_veg_pc_colouring_encroachments,
              any(model().u_selected_encroachment_key_pc_colour = list("All",class)),
              points.num_points > 0,
            ),
            points
          )
        )
        '''
    }
    {
      name: "veg~u_viz_p4_body"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula:
        '''
        let(
          viz: u_veg_environment.u_p4_body,
          class: "P4",
          if(
            and(
              model().u_show_encroachment_bodies,
              any(model().u_selected_encroachment_key_body = list("All",class)),
              len(filter(model().Spans,model().Spans[].selected)) = 1,
              selected
            ),
            viz
          )
        )
        '''
    }
    {
      name: "veg~u_viz_p4_dynamic_points"
      prominence: "normal"
      documentation: null
      visibility: "public"
