      formula:
        '''
        let(
          points: u_custom_env_sim.u_p4_points,
          class: "P4",
            
          if(
            and(
              model().u_show_veg_pc_colouring_encroachments,
              any(model().u_selected_encroachment_key_pc_colour = list("All",class)),
              points.num_points > 0,
            ),
            points
          )
        )
        '''
    }
    {
      name: "veg~u_viz_p4_points"
      prominence: "normal"
      documentation: null
      visibility: "public"
