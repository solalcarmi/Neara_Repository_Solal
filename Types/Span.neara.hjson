          points: u_veg_environment.u_p4_points,
          class: "P4",
          if(
            and(
              model().u_show_veg_pc_colouring_encroachments,
              any(model().u_selected_encroachment_key_pc_colour = list("All",class)),
              points.num_points > 0,
            ),
            points
          )
        )
        '''
    }
    {
      name: "veg~u_viz_points_wind_sweep"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula:
        '''
        if(
          and(selected,model().u_show_wind_sweep_body),
          u_points_veg_wind_sweep
        )
        '''
    }
    {
      name: "veg~u_viz_rate_span"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula:
        '''
        if(
          and(selected,model().u_enable_rate_span),
          u_rate_span.viz
        )
        '''
    }
    {
      name: "veg~u_viz_span_buffer"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula:
        '''
        let(
          focus_sections: filter(u_span_veg_sections,u_span_veg_sections[].points_veg_buffer[].num_points = 0),
          gis_boolean:
          or(
            and(gis_properties = null,  not(model().u_show_pc_for_only_gis_spans)),
            gis_properties <> null
          ),
          
          let(
            viz: 
              if(
                model().u_selected_buffer_key_measurement = "Worst",
                  min_by(focus_sections,focus_sections[].distance_to_veg[].distance).viz_clearance,
                model().u_selected_buffer_key_measurement <> "All",  
                  viz(filter(focus_sections, focus_sections[].encroachment_key = model().u_selected_buffer_key_measurement)[].viz_clearance),
                  viz(focus_sections[].viz_clearance),
               ),      
             
             if(
              and(
                model().u_show_buffer_measurements,
                gis_boolean
              ),
              viz   
            )   
          )
        )
        '''
    }
    {
      name: "veg~u_viz_span_encroachments"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula:
        '''
        let(
          focus_sections: filter(u_span_veg_sections,u_span_veg_sections[].points_veg_prune[].num_points > 0),
          let(
            viz: 
              if(
                model().u_selected_encroachment_key_measurement = "Worst",
                  min_by(focus_sections,focus_sections[].distance_to_veg[].distance).viz_clearance,
                model().u_selected_encroachment_key_measurement <> "All",  
                  viz(filter(focus_sections, focus_sections[].encroachment_key = model().u_selected_encroachment_key_measurement)[].viz_clearance),
                  viz(focus_sections[].viz_clearance),
               ),      
             
             if(
                model().u_show_encroachment_measurements,
                viz   
            )   
          )
        )
        '''
    }
    {
      name: "veg~u_viz_wind_direction"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula:
        '''
        if(
          model().u_wind_pressure > unit_value(0,"Pa"),
        
          viz("style", "solid #acfcfc width:0.4", list(
            viz("arrow",
              vec3(u_wind_direction_vector,(approximate_midpoint.z)),
              approximate_midpoint),
              pole1.u_viz_wind_direction,
              pole2.u_viz_wind_direction
            )
          )
        )
        '''
    }
    {
      name: "veg~u_viz_wind_sweep_blowout"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula:
        '''
        if(
          and(selected,model().u_show_wind_sweep_body),
          u_wind_sweep_environment.blowout_distance
        )
        '''
    }
    {
      name: "veg~u_viz_wind_sweep_body"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula:
        '''
        if(
          and(selected,model().u_show_wind_sweep_body),
          u_wind_sweep_body
        )
        '''
    }
    {
      name: "veg~u_viz_wind_sweep_cables"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula:
        '''
        if(
          and(selected,model().u_show_wind_sweep_body),
          u_wind_sweep_environment.viz_cables
        )
        '''
    }
    {
      name: "veg~u_voltage"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula:
        '''
        text_unit(section.voltage,"kV")
        '''
    }
    {
      name: "veg~u_voltage_2"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula: "345kV"
    }
    {
      name: "veg~u_wind_direction_vector"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula:
        '''
        vec2(
          approximate_midpoint.x + sin(model().u_cust_env_wind_direction_radians)*model().u_cust_env_wind_magnitude_factor*unit("m"),
          approximate_midpoint.y + cos(model().u_cust_env_wind_direction_radians)*model().u_cust_env_wind_magnitude_factor*unit("m"),
        )
        '''
    }
    {
      name: "veg~u_wind_sweep_body"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula:
        '''
        make_wind_sweep(
          span: self,
          base_environment: make_environment(wire_temperature: model().u_temperature, wind_pressure_cond:0Pa),
          max_wind_pressure: model().u_wind_pressure
        )
        '''
    }
    {
      name: "veg~u_wind_sweep_environment"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula:
        '''
        simulate(
          self,
          environment: make_environment(wire_temperature: model().u_temperature, wind_pressure_cond:model().u_wind_pressure)
        )
        '''
    }
  ]
}
