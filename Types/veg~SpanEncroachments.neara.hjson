{
  token: "veg~ct_SpanEncroachments"
  is_custom_class: true
  fields: [
    {
      name: "cables"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula: "span.u_veg_environment.Cables"
    }
    {
      name: "conductor_key"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula: "span.section.u_conductor_key"
    }
    {
      name: "distance_to_veg"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula: "measure_distance(cables,points_veg)"
    }
    {
      name: "encroachment_key"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula:
        '''
        if(
          intersect_points(points_veg,span.u_veg_environment.u_p1_points).num_points > 0, "P1",
          intersect_points(points_veg,span.u_veg_environment.u_p2_points).num_points > 0, "P2",
          intersect_points(points_veg,span.u_veg_environment.u_p3_points).num_points > 0, "P3",
          intersect_points(points_veg,span.u_veg_environment.u_p4_points).num_points > 0, "P4",
          
        )
        '''
    }
    {
      name: "geom"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula: "veg_section.geom"
    }
    {
      name: "gis_layer"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula: "span.u_gis_layer"
    }
    {
      name: "length"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula: "span.length"
    }
    {
      name: "oh_points"
      prominence: "normal"
