        '''
        if(
          len(model().dt_trees) > 0,
          broadcast(
            tree: model().dt_trees,
            make_immutable_record(
              "TreesSatellite",
              tree: tree
            )   
          )
        )
        '''
    }
    {
      name: "veg~u_trimmed_feeders"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula:
        '''
        dt_trimmed_feeders[].feeder_number&""
        '''
    }
    {
      name: "veg~u_veg_analytics_report_ench"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula:
        '''
        find(
          AnalyticsReports,
          AnalyticsReports[].title = "Span Encroachment"
        )
        '''
    }
    {
      name: "veg~u_veg_analytics_report_fir"
