    {
      name: "veg~u_filter_year_formula"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula:
        '''
        if(
          or(u_filter_year_selected = "",u_filter_year_selected = null, u_filter_year_selected = "all"),
          
          range(1948,2030)&"",
          
          (range(int(index(text_split(u_filter_year_selected,"-"),0)),int(index(text_split(u_filter_year_selected,"-"),1))+1))&""
        )
        '''
    }
    {
      name: "veg~u_filter_year_select"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
