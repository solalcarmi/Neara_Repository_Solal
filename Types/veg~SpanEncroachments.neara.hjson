      visibility: "public"
      type: "formula"
      formula:
        '''
        intersect_points(
          points_veg,
          span.u_veg_environment.u_points_oh_veg,
          "oh_veg",
        )
        '''
    }
    {
      name: "points_veg"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula: "veg_section.points_veg"
    }
    {
      name: "points_veg_buffer"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula:
        '''
        intersect_points(points_veg,span.u_veg_environment.u_buffer_points,"veg_buffer")
        '''
    }
    {
      name: "points_veg_prune"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula:
        '''
        intersect_points(points_veg,span.u_veg_environment.u_prune_points,"veg_prune")
        '''
    }
    {
      name: "pole1"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
