      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula:
        '''
        let(
          props: fetch_analytics_report("oncor~Oncor PLA",dataset_id: "dGwb5XGPlXwR"),
          
          broadcast(
            prop: props,
            make_immutable_record(
              "PLAReport",
              properties: prop
            )
          )
        )
        '''
    }
