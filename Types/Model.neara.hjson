    }
    {
      name: "veg~u_cust_env_wind_direction_radians"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula: "u_cust_env_wind_direction*pi()/180 // + pi()"
    }
    {
      name: "veg~u_cust_env_wind_magnitude_factor"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula:
        '''
        min(parse_num(model().u_cust_env_wind_pressure&"")*0.05,20)
        '''
    }
