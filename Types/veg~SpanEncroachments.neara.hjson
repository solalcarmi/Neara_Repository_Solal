    }
    {
      name: "pole2"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula: "span.stack.global_pole2"
    }
    {
      name: "report_global_id"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula:
        '''
        veg_section.report_global_id&"_"&span.id
        '''
    }
    {
      name: "span"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula: "index(model().Spans,-1)"
    }
    {
      name: "veg_section"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula: "index(model().u_veg_sections,-1)"
    }
    {
      name: "viz_clearance"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula:
        '''
        let(
          color: try(map_lookup(model().u_encroachment_colour_map,encroachment_key),"white"),
          
          viz(list(
            viz("style", color&" width:0.05 solid",
              list(
              viz("line",distance_to_veg.start,distance_to_veg.end)
                )
              ),
            viz("style", "blue bg_color:white font_size:15",
              list(
              viz("text",distance_to_veg.start + (distance_to_veg.end - distance_to_veg.start)*0.5,
                text_unit(distance_to_veg.distance,"ft",2) & "\n" &
                encroachment_key
                 ))
              ),
        
          ))
        )
        '''
    }
    {
      name: "voltage"
      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula: "span.u_voltage"
    }
  ]
}
