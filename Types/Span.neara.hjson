          if(
            and(
              model().u_show_encroachment_bodies,
              any(model().u_selected_encroachment_key_body = list("All",class)),
              len(filter(model().Spans,model().Spans[].selected)) = 1,
              selected
            ),
            viz
          )
        )
        '''
    }
    {
      name: "veg~u_viz_p3_dynamic_points"
      prominence: "normal"
      documentation: null
      visibility: "public"
