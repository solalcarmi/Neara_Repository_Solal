      prominence: "normal"
      documentation: null
      visibility: "public"
      type: "formula"
      formula:
        '''
        if(
          or(u_filter_voltage_selected = "",u_filter_voltage_selected = null, u_filter_voltage_selected = "all"), 
          list("0.00kV","12.50kV","13.20kV","21.60kV"),
          u_filter_voltage_selected = "LV", list("0.00kV"),
          u_filter_voltage_selected = "HV", list("12.50kV","13.20kV","21.60kV"),
          list("0.00kV","12.50kV","13.20kV","21.60kV"),
        )
        '''
    }
    {
      name: "veg~u_filter_voltage_select"
      prominence: "normal"
