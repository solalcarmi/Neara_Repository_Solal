    }
    {
      name: "veg~u_analytic_report_list"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula:
        '''
        list(
          "Span Encroachment",
          "Fall-in Risk",
          "Fall-in w/o Encroachment",
        )
        '''
    }
    {
      name: "veg~u_analytics_report_activation"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula:
        '''
        let(
          other_reports: filter(AnalyticsReports,AnalyticsReports <> u_selected_analytic_server_report),          
          if(
            u_selected_analytic_server_report,
            ui_button(
              "Activate View", 
              do(
                u_selected_analytic_server_report.u_visualize_on,
                other_reports[].u_visualize_off, 
                make_field_mutation(self, u_activated_analytics_report: u_selected_analytics_report),
               ),
                enabled: u_activated_analytics_report <> u_selected_analytics_report
            )
          )
        )
        '''
    }
    {
      name: "veg~u_buffer_zone_increment"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "property"
      kind: "real"
      unit: "m"
    }
