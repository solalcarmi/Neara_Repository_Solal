      visibility: "module"
      type: "formula"
      formula:
        '''
        find(
          AnalyticsReports,
          AnalyticsReports[].title = "Fall-in Risk"
        )
        '''
    }
    {
      name: "veg~u_veg_analytics_report_fir_no_ench"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula:
        '''
        find(AnalyticsReports, AnalyticsReports[].title = "Fall-in w/o Encroachment")
        '''
    }
    {
      name: "veg~u_veg_clearance_rules_read_ony"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula:
        '''
        broadcast(
          rule: veg_clearance_rules,
          
          make_immutable_record(
            "ClearanceRulesRead",   
              index: rule.index,
              conductor_key: rule.conductor_key,
              span_length_lower_limit: rule.span_length_lower_limit,
              span_length_upper_limit: rule.span_length_upper_limit,      
              
              clearance_radial_ends: rule.clearance_radial_ends,
              clearance_radial_middle: rule.clearance_radial_middle,
              clearance_above: rule.clearance_above,
              clearance_below: rule.clearance_below,
              bushfire_factor: rule.bushfire_factor,   
          )
        )
        '''
    }
    {
      name: "veg~u_veg_sections"
      prominence: "normal"
      documentation: null
      visibility: "module"
      type: "formula"
      formula: "model().SpanStacks[].u_bay_sections[].veg_sections"
    }
